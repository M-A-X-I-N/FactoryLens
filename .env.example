# Copy to .env and keep the real file untracked.
# SML Starter Project root containing FactoryGame.uproject.
SML_PROJECT_ROOT=

# Optional explicit Unreal Engine root. If unset on Windows, FactoryLens resolves
# FactoryGame.uproject's EngineAssociation from the per-user Unreal registry.
FACTORYLENS_ENGINE_ROOT=

# Explicit clangd executable for the supported semantic backend. The current
# Satisfactory/UE/SML validation baseline requires clangd major 20.
FACTORYLENS_CLANGD=
